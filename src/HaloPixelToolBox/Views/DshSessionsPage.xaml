<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaloPixelToolBox.Views.DshSessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HaloPixelToolBox.ViewModels">
    <Grid Margin="0,0,16,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="ConnectionLayout" ColumnSpacing="12" RowSpacing="8"
              SizeChanged="ConnectionLayout_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="DSH 会话" FontSize="24" FontWeight="SemiBold"/>
                    <Border Padding="8,3" CornerRadius="6" VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.VoiceStatusText, Mode=OneWay}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.VoiceDetail, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid x:Name="ConnectionActions" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ConnectionActionColumn0" Width="Auto"/>
                    <ColumnDefinition x:Name="ConnectionActionColumn1" Width="Auto"/>
                    <ColumnDefinition x:Name="ConnectionActionColumn2" Width="Auto"/>
                    <ColumnDefinition x:Name="ConnectionActionColumn3" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="NewTaskButton" Click="NewSpeakerTask_Click" IsEnabled="{x:Bind ViewModel.CanStartTask, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,7"
                        AutomationProperties.Name="新建音箱任务" ToolTipService.ToolTip="创建独立任务文件夹和会话，可通过音箱继续管理">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="新建任务"/></StackPanel>
                </Button>
                <Button x:Name="VoiceActionButton" Grid.Column="1" Command="{x:Bind ViewModel.ToggleVoiceListeningCommand}"
                        HorizontalAlignment="Stretch" Padding="12,7"
                        AutomationProperties.Name="{x:Bind ViewModel.VoiceActionText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.VoiceTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE720;" FontSize="14"/>
                            <ProgressRing Width="16" Height="16" IsActive="True"
                                          Visibility="{x:Bind ViewModel.VoiceBusyVisibility, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.VoiceActionText, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ConnectDshButton" Grid.Column="2" Command="{x:Bind ViewModel.ConnectCommand}"
                        Visibility="{x:Bind ViewModel.ConnectActionVisibility, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="10,7"
                        AutomationProperties.Name="连接本机 DSH" ToolTipService.ToolTip="启动并连接设置中配置的本机 DSH 服务">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE703;" FontSize="14"/>
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsConnectionBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.ConnectionBusyVisibility, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Text="连接 DSH"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshSessionsButton" Grid.Column="3" Command="{x:Bind ViewModel.RefreshCommand}"
                        MinWidth="36" MinHeight="36" Padding="8" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="刷新会话" ToolTipService.ToolTip="刷新会话列表和当前历史">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4">
            <Border CornerRadius="8" Padding="12,8"
                    Visibility="{x:Bind ViewModel.TaskPanelVisibility, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.TaskSummary, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.TaskDetails, Mode=OneWay}"/>
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.TaskDetailsActionText, Mode=OneWay}" Click="TaskDetails_Click"
                            FontSize="12" Padding="8,4" MinHeight="32" ToolTipService.ToolTip="查看任务状态并处理问题或授权"/>
                    <Button Grid.Column="2" Content="打开" Command="{x:Bind ViewModel.OpenTaskSessionCommand}"
                            FontSize="12" Padding="8,4" MinHeight="32" ToolTipService.ToolTip="打开正在监控的任务会话"/>
                    <Button Grid.Column="3" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="任务监控操作"
                            AutomationProperties.Name="更多任务操作">
                        <FontIcon Glyph="&#xE712;" FontSize="16"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="停止监控" Command="{x:Bind ViewModel.StopTaskMonitoringCommand}"/>
                                <MenuFlyoutItem Text="取消当前轮" Command="{x:Bind ViewModel.CancelTaskCommand}"
                                                Visibility="{x:Bind ViewModel.CancelTaskVisibility, Mode=OneWay}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.ConnectionIssueText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.ConnectionIssueVisibility, Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="2"/>
            <TextBlock Text="{x:Bind ViewModel.SessionOperationStatus, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.SessionOperationStatusVisibility, Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.SessionOperationStatus, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True"/>
        </StackPanel>

        <Grid x:Name="SessionsWorkspace" Grid.Row="2" ColumnSpacing="12"
              SizeChanged="SessionsWorkspace_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SessionDetailsColumn" Width="*"/>
                <ColumnDefinition x:Name="SessionListColumn" Width="240"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SessionDetailsPane" Padding="16" CornerRadius="12"
                    Visibility="{x:Bind ViewModel.DetailsPaneVisibility, Mode=OneWay}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.BackToListCommand}" Padding="0"
                                    Width="32" Height="32" ToolTipService.ToolTip="返回会话列表" AutomationProperties.Name="返回会话列表"
                                    Visibility="{x:Bind ViewModel.BackButtonVisibility, Mode=OneWay}"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}"/>
                            <Button Grid.Column="2" Width="32" Height="32" Padding="0" AutomationProperties.Name="更多会话操作"
                                    ToolTipService.ToolTip="重命名、归档或选择音箱目标" Visibility="{x:Bind ViewModel.SelectedActionsVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="重命名" Click="RenameSession_Click" IsEnabled="{x:Bind ViewModel.CanRenameSession, Mode=OneWay}"/>
                                        <MenuFlyoutItem Text="归档" Command="{x:Bind ViewModel.ArchiveSessionCommand}"
                                                        Visibility="{x:Bind ViewModel.ArchiveSessionVisibility, Mode=OneWay}"/>
                                        <MenuFlyoutItem Text="恢复会话" Command="{x:Bind ViewModel.RestoreSessionCommand}"
                                                        Visibility="{x:Bind ViewModel.RestoreSessionVisibility, Mode=OneWay}"/>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ArchiveSupportText, Mode=OneWay}" FontSize="12" IsEnabled="False"
                                                        Visibility="{x:Bind ViewModel.ArchiveSupportVisibility, Mode=OneWay}"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="监控音箱任务" Command="{x:Bind ViewModel.MonitorSelectedTaskCommand}"/>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.VoiceTargetActionText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.SelectVoiceTargetCommand}"/>
                                        <MenuFlyoutItem Text="清除音箱目标" Command="{x:Bind ViewModel.ClearVoiceTargetCommand}"
                                                        Visibility="{x:Bind ViewModel.ClearTargetVisibility, Mode=OneWay}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SelectedStatus, Mode=OneWay}" FontSize="12"
                                   Visibility="{x:Bind ViewModel.SelectedActionsVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="8" MinHeight="24" Visibility="{x:Bind ViewModel.SelectedActionsVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.HistoryLoadingVisibility, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HistoryStatus, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Grid.Column="2" Content="重试" Command="{x:Bind ViewModel.RetryHistoryCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.HistoryErrorDetail, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RetryHistoryVisibility, Mode=OneWay}" FontSize="11" Padding="8,3" MinHeight="24"/>
                        <Button Grid.Column="3" Content="更早记录" Command="{x:Bind ViewModel.LoadEarlierCommand}"
                                ToolTipService.ToolTip="加载更早记录"
                                Visibility="{x:Bind ViewModel.LoadEarlierVisibility, Mode=OneWay}" FontSize="11" Padding="8,3" MinHeight="24"/>
                        <Button Grid.Column="4" Content="回到最新" Command="{x:Bind ViewModel.LoadLatestCommand}"
                                Visibility="{x:Bind ViewModel.LoadLatestVisibility, Mode=OneWay}" FontSize="11" Padding="8,3" MinHeight="24"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="HistoryListView" Loaded="HistoryListView_Loaded" SizeChanged="HistoryListView_SizeChanged"
                                  ItemsSource="{x:Bind ViewModel.VisibleHistory}" SelectionMode="None"
                                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DshHistoryListItem">
                                    <Grid Margin="0,5">
                                        <Grid HorizontalAlignment="{x:Bind BubbleAlignment}" Margin="{x:Bind BubbleMargin}" MaxWidth="720">
                                            <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            <Border CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind UserBubbleVisibility}"/>
                                            <StackPanel Spacing="8" Padding="14,12">
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="14" LineHeight="22" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind MessageTextVisibility}"/>
                                                <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch" Visibility="{x:Bind CollapsedRecordVisibility}">
                                                    <Expander.Header>
                                                        <TextBlock Text="{x:Bind CollapsedSummary}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </Expander.Header>
                                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="14" LineHeight="22" IsTextSelectionEnabled="True"/>
                                                </Expander>
                                                <Expander Header="历史语音上下文" IsExpanded="{x:Bind IsOriginalExpanded, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          Visibility="{x:Bind OriginalTextVisibility}" FontSize="12">
                                                    <TextBlock Text="{x:Bind OriginalText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                </Expander>
                                                <Grid ColumnSpacing="8" Visibility="{x:Bind ConversationMetadataVisibility}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind RoleText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CreatedAtText}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.EmptyHistoryMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.EmptyHistoryVisibility, Mode=OneWay}"
                                   Margin="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Border Grid.Row="3" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.ComposerVisibility, Mode=OneWay}">
                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposerTextBox" Grid.ColumnSpan="2" MinHeight="64" MaxHeight="160" MaxLength="4096"
                                     Text="{x:Bind ViewModel.MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder, Mode=OneWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="14" Padding="12,10" AutomationProperties.Name="当前会话消息"
                                     KeyUp="Composer_KeyUp"
                                     TextCompositionStarted="Composer_TextCompositionStarted" TextCompositionEnded="Composer_TextCompositionEnded"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <Grid Grid.Row="1" MinHeight="18" VerticalAlignment="Center">
                                <TextBlock x:Name="ComposerHintText" Text="Enter 发送 · Shift+Enter 换行" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SendStatus, Mode=OneWay}" FontSize="11"
                                           Visibility="{x:Bind ViewModel.SendStatusVisibility, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.SendStatus, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <Button Grid.Row="1" Grid.Column="1" Content="发送" Command="{x:Bind ViewModel.SendMessageCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="16,6" MinHeight="36" AutomationProperties.Name="发送消息"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SessionListPane" Grid.Column="1" Padding="12" CornerRadius="12"
                    Visibility="{x:Bind ViewModel.ListPaneVisibility, Mode=OneWay}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="会话" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SessionCountText, Mode=OneWay}" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Grid.Column="2" Click="NewSession_Click" IsEnabled="{x:Bind ViewModel.CanCreateSession, Mode=OneWay}"
                                Width="32" Height="32" Padding="0" AutomationProperties.Name="新建会话" ToolTipService.ToolTip="新建普通 DSH 会话">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="3" Width="32" Height="32" Padding="0" AutomationProperties.Name="筛选会话" ToolTipService.ToolTip="会话筛选">
                            <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                            <Button.Flyout><MenuFlyout>
                                <ToggleMenuFlyoutItem Text="显示已归档会话" IsChecked="{x:Bind ViewModel.ShowArchived, Mode=TwoWay}"/>
                            </MenuFlyout></Button.Flyout>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="搜索会话或目录" AutomationProperties.Name="搜索会话" ToolTipService.ToolTip="搜索标题或工作目录"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="SessionsList" ItemsSource="{x:Bind ViewModel.Sessions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=OneWay}"
                                  SelectionMode="Single" SelectionChanged="SessionsList_SelectionChanged" IsItemClickEnabled="True" ItemClick="SessionsList_ItemClick"
                                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DshSessionListItem">
                                    <StackPanel Spacing="6" Padding="2,8">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}"/>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind MetadataText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind TargetLabel}" FontSize="11"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.EmptyListMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.EmptyListVisibility, Mode=OneWay}"
                                   Margin="10" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
