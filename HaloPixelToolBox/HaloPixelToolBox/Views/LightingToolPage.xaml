<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaloPixelToolBox.Views.LightingToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HaloPixelToolBox.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="LightingPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="LightingCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="70"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,24,24" MaxWidth="1280">
            <StackPanel Spacing="4">
                <TextBlock Text="灯光控制" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="分别为桌面环境光和像素屏主题色直接选色；每次改动都会即时发送。"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Grid x:Name="LightingCardsGrid" ColumnSpacing="16" RowSpacing="16">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="NarrowLightingCards">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientLightingColumn.Width" Value="*"/>
                                <Setter Target="PixelLightingColumn.Width" Value="0"/>
                                <Setter Target="AmbientLightingCard.(Grid.Row)" Value="0"/>
                                <Setter Target="AmbientLightingCard.(Grid.Column)" Value="0"/>
                                <Setter Target="PixelLightingCard.(Grid.Row)" Value="1"/>
                                <Setter Target="PixelLightingCard.(Grid.Column)" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideLightingCards">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1180"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientLightingColumn.Width" Value="*"/>
                                <Setter Target="PixelLightingColumn.Width" Value="*"/>
                                <Setter Target="AmbientLightingCard.(Grid.Row)" Value="0"/>
                                <Setter Target="AmbientLightingCard.(Grid.Column)" Value="0"/>
                                <Setter Target="PixelLightingCard.(Grid.Row)" Value="0"/>
                                <Setter Target="PixelLightingCard.(Grid.Column)" Value="1"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactRgbEditors">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientRgbColumn.Width" Value="0"/>
                                <Setter Target="AmbientColorPicker.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Row)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Column)" Value="0"/>
                                <Setter Target="AmbientRgbEditor.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="AmbientRgbEditor.Orientation" Value="Horizontal"/>
                                <Setter Target="PixelRgbColumn.Width" Value="0"/>
                                <Setter Target="PixelColorPicker.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="PixelRgbEditor.(Grid.Row)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.Column)" Value="0"/>
                                <Setter Target="PixelRgbEditor.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="PixelRgbEditor.Orientation" Value="Horizontal"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="SideRgbEditors">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientRgbColumn.Width" Value="104"/>
                                <Setter Target="AmbientColorPicker.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Row)" Value="0"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Column)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.Orientation" Value="Vertical"/>
                                <Setter Target="PixelRgbColumn.Width" Value="104"/>
                                <Setter Target="PixelColorPicker.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.Row)" Value="0"/>
                                <Setter Target="PixelRgbEditor.(Grid.Column)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="PixelRgbEditor.Orientation" Value="Vertical"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="InlineRgbEditors">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1180"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientRgbColumn.Width" Value="0"/>
                                <Setter Target="AmbientColorPicker.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Row)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Column)" Value="0"/>
                                <Setter Target="AmbientRgbEditor.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="AmbientRgbEditor.Orientation" Value="Horizontal"/>
                                <Setter Target="PixelRgbColumn.Width" Value="0"/>
                                <Setter Target="PixelColorPicker.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="PixelRgbEditor.(Grid.Row)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.Column)" Value="0"/>
                                <Setter Target="PixelRgbEditor.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="PixelRgbEditor.Orientation" Value="Horizontal"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideSideRgbEditors">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1500"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AmbientRgbColumn.Width" Value="104"/>
                                <Setter Target="AmbientColorPicker.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Row)" Value="0"/>
                                <Setter Target="AmbientRgbEditor.(Grid.Column)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="AmbientRgbEditor.Orientation" Value="Vertical"/>
                                <Setter Target="PixelRgbColumn.Width" Value="104"/>
                                <Setter Target="PixelColorPicker.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.Row)" Value="0"/>
                                <Setter Target="PixelRgbEditor.(Grid.Column)" Value="1"/>
                                <Setter Target="PixelRgbEditor.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="PixelRgbEditor.Orientation" Value="Vertical"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="AmbientLightingColumn" Width="*"/>
                    <ColumnDefinition x:Name="PixelLightingColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="AmbientLightingCard" Style="{StaticResource LightingPanelStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="氛围灯" Style="{StaticResource LightingCaptionStyle}"/>
                                <TextBlock Text="桌面环境光" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="开关、灯效、颜色、速度和亮度会自动发送到设备。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="开关" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AmbientEnabled, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              Width="40"
                                              MinWidth="40"
                                              HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.AmbientHex, Mode=OneWay}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid x:Name="AmbientPickerLayout"
                                  ColumnSpacing="12"
                                  RowSpacing="12"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="AmbientRgbColumn" Width="104"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Viewbox HorizontalAlignment="Stretch"
                                    Stretch="Uniform"
                                    StretchDirection="Both">
                                    <ColorPicker x:Name="AmbientColorPicker"
                                                Color="{x:Bind ViewModel.AmbientPickerColor, Mode=OneWay}"
                                                ColorChanged="AmbientColorPicker_ColorChanged"
                                                IsAlphaEnabled="False"
                                                IsMoreButtonVisible="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsHexInputVisible="False"
                                                HorizontalAlignment="Stretch"
                                                MinWidth="0"/>
                                </Viewbox>
                                <StackPanel x:Name="AmbientRgbEditor"
                                            Grid.Column="1"
                                            Spacing="8"
                                            HorizontalAlignment="Left">
                                    <NumberBox Header="红 R"
                                               Value="{x:Bind ViewModel.AmbientRed, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Header="绿 G"
                                               Value="{x:Bind ViewModel.AmbientGreen, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Header="蓝 B"
                                               Value="{x:Bind ViewModel.AmbientBlue, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="直接点击色板即可选择颜色并发送。"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="灯效模式" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <RadioButtons ItemsSource="{x:Bind ViewModel.EffectNames}"
                                          SelectedIndex="{x:Bind ViewModel.AmbientEffectIndex, Mode=TwoWay}"
                                          MaxColumns="3"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="灯效速度" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.AmbientSpeed, Mode=OneWay}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.AmbientSpeed, Mode=TwoWay}" Minimum="1" Maximum="10" StepFrequency="1"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="亮度调节" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <RadioButtons ItemsSource="{x:Bind ViewModel.BrightnessNames}"
                                          SelectedIndex="{x:Bind ViewModel.AmbientBrightnessIndex, Mode=TwoWay}"
                                          MaxColumns="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="PixelLightingCard" Grid.Column="1" Style="{StaticResource LightingPanelStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="像素屏" Style="{StaticResource LightingCaptionStyle}"/>
                                <TextBlock Text="主题颜色" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="开关和主题颜色会立即发送；可选择同步桌面环境光。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="屏幕开关" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.PixelScreenEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="像素屏开关"
                                                  OnContent=""
                                                  OffContent=""
                                                  Width="40"
                                                  MinWidth="40"
                                                  HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="同步环境光" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.SyncAmbientWithPixel, Mode=TwoWay}"
                                                  AutomationProperties.Name="像素屏颜色同步环境光"
                                                  OnContent=""
                                                  OffContent=""
                                                  Width="40"
                                                  MinWidth="40"
                                                  HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.PixelHex, Mode=OneWay}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid x:Name="PixelPickerLayout"
                                  ColumnSpacing="12"
                                  RowSpacing="12"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="PixelRgbColumn" Width="104"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Viewbox HorizontalAlignment="Stretch"
                                    Stretch="Uniform"
                                    StretchDirection="Both">
                                    <ColorPicker x:Name="PixelColorPicker"
                                                Color="{x:Bind ViewModel.PixelPickerColor, Mode=OneWay}"
                                                ColorChanged="PixelColorPicker_ColorChanged"
                                                IsAlphaEnabled="False"
                                                IsMoreButtonVisible="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsHexInputVisible="False"
                                                HorizontalAlignment="Stretch"
                                                MinWidth="0"/>
                                </Viewbox>
                                <StackPanel x:Name="PixelRgbEditor"
                                            Grid.Column="1"
                                            Spacing="8"
                                            HorizontalAlignment="Left">
                                    <NumberBox Header="红 R"
                                               Value="{x:Bind ViewModel.PixelRed, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Header="绿 G"
                                               Value="{x:Bind ViewModel.PixelGreen, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Header="蓝 B"
                                               Value="{x:Bind ViewModel.PixelBlue, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Width="96"
                                               MinWidth="0"
                                               SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="色彩方案" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="将氛围灯与像素屏颜色保存为一组。"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ColorPresetSummary, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="保存当前"
                                            VerticalAlignment="Center"
                                            Click="SaveCurrentColorPreset_Click"/>
                                </Grid>

                                <TextBlock x:Name="EmptyColorPresetsMessage"
                                           x:Load="{x:Bind ViewModel.HasColorPresets, Mode=OneWay, Converter={StaticResource BooleanInverseConverter}}"
                                           Text="还没有保存的色彩方案。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <ListView x:Name="ColorPresetsList"
                                          x:Load="{x:Bind ViewModel.HasColorPresets, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.ColorPresets, Mode=OneWay}"
                                          SelectionMode="None"
                                          MaxHeight="320"
                                          HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LightingColorPreset">
                                            <Grid Padding="8" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MinWidth="0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                                <Border Grid.Column="1"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="氛围灯颜色">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind AmbientColor, Mode=OneWay}"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="像素屏颜色">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind PixelColor, Mode=OneWay}"/>
                                                    </Border.Background>
                                                </Border>
                                                <Button Grid.Column="3"
                                                        Content="应用"
                                                        Tag="{x:Bind}"
                                                        Click="ApplyColorPreset_Click"/>
                                                <Button Grid.Column="4"
                                                        Content="管理"
                                                        Tag="{x:Bind}"
                                                        Click="ManageColorPreset_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
