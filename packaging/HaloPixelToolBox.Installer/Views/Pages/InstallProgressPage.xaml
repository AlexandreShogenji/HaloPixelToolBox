<Page x:Class="HaloPixelToolBox.Installer.Views.Pages.InstallProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:ctr="clr-namespace:HaloPixelToolBox.Installer.Views.Controls"
      xmlns:viewmodel="clr-namespace:HaloPixelToolBox.Installer.ViewModel.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HaloPixelToolBox.Installer.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=viewmodel:InstallProgressPageViewModel}"
      Title="InstallProgressPage" Loaded="Page_Loaded">

    <Grid>
        <Grid x:Name="installGrid" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="正在安装中" FontSize="15" Margin="10,0,0,0"/>
            <ctr:ModernProgressBar x:Name="progress" Grid.Column="1" Margin="10,0,10,0" Height="10" ProgressBarCornerRadius="5" IsBusy="True" Value="100"/>
        </Grid>
        <Grid x:Name="successGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="已完成安装" HorizontalAlignment="Center" FontSize="32"/>
                <TextBlock Text="HaloPixelToolBox 已成功安装到电脑" Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.72" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ctr:RoundButton Width="190" Height="40" Margin="10,0" Command="{Binding OpenApplicationCommand}">
                    <TextBlock Text="打开 HaloPixelToolBox" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MainColor}" FontSize="17"/>
                </ctr:RoundButton>
                <ctr:RoundButton Width="140" Height="40" Margin="10,0" Command="{Binding CloseInstallerCommand}">
                    <TextBlock Text="关闭安装器" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MainColor}" FontSize="17"/>
                </ctr:RoundButton>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
